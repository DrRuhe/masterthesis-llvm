@LIT_SITE_CFG_IN_HEADER@


config.llvm_tools_dir = "@LLVM_TOOLS_DIR@"
config.llvm_libs_dir = "@LLVM_LIBS_DIR@"
config.llvm_shlib_dir = "@SHLIBDIR@"
config.llvm_plugin_ext = "@CMAKE_SHARED_LIBRARY_SUFFIX@"

# LLVM include paths (source + build)
config.llvm_src_root = "@LLVM_SOURCE_DIR@"
config.llvm_obj_root = "@LLVM_BINARY_DIR@"
config.llvm_src_include = "@LLVM_SOURCE_DIR@/include"
config.llvm_obj_include = "@LLVM_BINARY_DIR@/include"

config.additional_clang_flags = "@CMAKE_CXX_FLAGS@"


config.target_triple = "@LLVM_HOST_TRIPLE@"
config.host_triple = "@LLVM_HOST_TRIPLE@"

config.runtime_specializer_src_root = "@CMAKE_CURRENT_SOURCE_DIR@"
config.runtime_specializer_obj_root = "@CMAKE_CURRENT_BINARY_DIR@"
config.test_source_root = "@CMAKE_CURRENT_SOURCE_DIR@" + "/test"

# RuntimeSpecializer specific paths (from CMake)
config.runtime_specializer_include_dir = "@CMAKE_CURRENT_SOURCE_DIR@/runtime/ClangRuntimeSpecializer"

print(f"Loaded {__file__} with test source root {config.test_source_root}")



# Die eigentliche Suite-Konfiguration laden (die ruft dann initialize()).
lit_config.load_config(config, "@CMAKE_CURRENT_SOURCE_DIR@/test/lit.cfg.py")